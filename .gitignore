# Compiled programs never belong in version control. They are large, they
# change on every build, and anyone with the source can make them again in
# a second.
build/
a.out
*.o
*.so
*.exe

# Sanitizer and debugger leftovers
*.dSYM/
core
vgcore.*

# Editor and OS noise
*~
*.swp
.DS_Store
.vscode/
.idea/
